fn scale(v, n) {
	v[:x] = v[:x] * n
	v[:y] = v[:y] * n
	return v
}

fn add(v1, v2) {
	for (v1) |k, v| {
		v1[k] = v + v2[k]
	}
	return v1
}

fn print_vec(v) {
	print(".{ ", v[:x], v[:y], " }")
}

var vec = .{:x 20, :y 50}
print(vec)

# mutable value semantics, even though scale "mutates" its argument it was passed as a value semantically
var another = scale(vec, 2)
print(another)

# Values are passed Copy-On-Write, when reference count == 1, mutates in place for perf
vec = add(vec, .{:x 1, :y 1})
print(vec)

