fn fib(x) {
	var i = 0
	var a = 0
	var b = 1
	var result = []

	while (i < x) {
		result = append(result, a)
		var tmp = a + b
		a = b
		b = tmp
		i = i + 1
	}

	result = append(result, a)
	return result
}


var res = fib(50)
var i = 0
while (i < len(res)) {
	print("fib ", i, ": ", res[i])
	i = i+1
}

print("number:", len(1))
print("nil:", len(nil))
print("string:", len("my_string", 2))
